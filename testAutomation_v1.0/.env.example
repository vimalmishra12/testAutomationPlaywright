# .env.example — template for every secret token (ADR-025). TRACKED, contains NO values.
#
# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
# `cp .env.example .env` from the testAutomation_v1.0 directory.
#
# How it works: test data, env.json and capabilities.json carry {{env.NAME}} tokens instead of
# literals. Tokens resolve lazily at the single point ADR-022 already used for {{run.*}}
# (testrunner.identifyTest -> runContext.resolve), plus env.conf.js for the Cloudflare headers and
# core/runner/visualTest.js for Applitools. Resolution lives in core/utils/envConfig.js.
# A token that is consumed but unset or EMPTY THROWS at startup — it never resolves to "".
#
# CI (GitHub Actions + Semaphore) injects these as real pipeline environment variables instead;
# a value already present in the environment always wins over this file.
#
# Quoting: only whole-line comments are stripped, so a value containing `#` is safe unquoted.
# Keep values containing `#` quoted anyway — the first migration attempt lost 8 values' `#2`
# suffix to a parser that treated `#` as an inline comment (ADR-025 Finding 7).
#
# NOT migrated by policy (see ADR-025 "Scope rules"): account emails/usernames (non-secret),
# codesAndKeys / schoolKey / access codes / invalid_OTP (validation fixtures, largely negative-path),
# and weakPassword "abc" (a negative-path input, not a credential).

# ===== BB_THOR (4) — Integrations/Blackboard/thor/bbLogindata.json =====
BB_THOR_LTIDEEPLINKTEACHER_PASSWORD=
BB_THOR_LTISTUDENT_PASSWORD=
BB_THOR_LTITEACHER_PASSWORD=
BB_THOR_TEACHER_PASSWORD=

# ===== BLDR_QA (3) — Builder/qa/*.json + env.json Builder.qa headers =====
# The Client-Id and the Client-Secret are TWO DIFFERENT values. The abandoned first attempt stored
# the secret under the *_CF_ID name and left *_CF_SECRET blank; wiring it up as named would have
# sent the secret in the CF-Access-Client-Id header and produced a 403 that looked like an expired
# token. Rotate in Cloudflare -> Access -> Service Tokens, then update both lines together.
BLDR_QA_CF_ACCESS_CLIENT_ID=
BLDR_QA_CF_ACCESS_CLIENT_SECRET=
BLDR_QA_VALIDADMIN_PASSWORD=

# ===== BLDR_THOR (1) — Builder/thor/*.json =====
BLDR_THOR_VALIDADMIN_PASSWORD=

