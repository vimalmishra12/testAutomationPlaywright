# Playwright MCP design-time tooling — browser/session artifacts must never be committed
tooling/playwright-mcp/.profile/
tooling/playwright-mcp/screenshots/
tooling/playwright-mcp/node_modules/
# MCP run output / config — ephemeral sessions or machine-specific config, never commit
# (the tooling/ tree itself stays tracked: README + dev scripts — see AGENTS.md §9)
.playwright-mcp/
.mcp.json

# General node_modules
node_modules/

# Allure and test output artifacts
allure-results/
allure-report/
output/
logs/
local.log

# Playwright migration (Prompt 4) run artefacts — never commit
# (mochawesome now writes under output/ — see core/runner/run.js — which is ignored above)
traces/
test/tempRunner/

# Visual regression artefacts — NOT committed. Each environment / CI runner
# (e.g. Semaphore) and each engineer generates and owns their own baselines
# locally (first --visual=novus run bootstraps them). This avoids cross-machine
# rendering diffs being committed as "the" baseline.
screenshots/baseline/
screenshots/screen/
screenshots/diff/

# Credential-bearing env backups must never be committed.
# [2026-09-28 ADR-025] This comment used to claim "env.json itself is tracked with placeholders" — it
# was wrong and dangerous: env.json was tracked AND carried the live Cloudflare Access secrets until
# this change. env.json is still tracked, but it now holds only {{env.*}} tokens, so anything written
# here is a stray copy of real credentials.
env copy.json
env.local.json
env.*.local.json

# runContext (ADR-022) — values generated by a run; per-machine, never commit
testResources/testcaseData/*/*/runtime/

# Secrets (ADR-025) — the live credential file and any per-machine/local variant must never be
# committed. .env.example (names only, no values) IS tracked and is the file to copy.
.env
.env.*
!.env.example