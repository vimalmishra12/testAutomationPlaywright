        "testData": [{ "dataFile": "./testResources/testcaseData/ExperienceApp/thor/adminStudentsTabData.json", "jsonPath": "C1.adminStudentsTab" }] },
      { "id": "TST_SLST_TC_21", "description": "Verify the user guide collapses and its panel is removed from the page", "testFile": "./test/ExperienceApp/adminStudentsTab.test.js",
        "testData": [{ "dataFile": "./testResources/testcaseData/ExperienceApp/thor/adminStudentsTabData.json", "jsonPath": "C1.adminStudentsTab" }] },
