    "AfterEach": [],
    "After": [
      { "id": "TST_STFL_TC_RESET", "description": "Clear the search once at suite end so nothing leaks into the next run (ADR-019: NOT AfterEach — the report screenshot is taken after AfterEach, so clearing there would erase the very evidence the search TCs assert)", "testFile": "./test/ExperienceApp/adminStaffTab.test.js",
