          {
            "dataFile": "./testResources/testcaseData/ExperienceApp/thor/classMaterialsData.json",
            "jsonPath": "C1.classMaterials.class1RB.bundle"
          }
        ]
      },
      {
        "id": "TST_CMAT_TC_3",
        "description": "Click Presentation Plus component within product bundle",
        "testFile": "./test/ExperienceApp/classMaterials.test.js",
        "testData": [
          {
            "dataFile": "./testResources/testcaseData/ExperienceApp/thor/classMaterialsData.json",
            "jsonPath": "C1.classMaterials.class1RB.presentationPlus"
          }
        ]
      },
      {
        "id": "TST_EBOO_TC_1",
