        "testFile": "./test/ExperienceApp/eBook.test.js",
        "testData": []
      },
      {
        "id": "TST_EMAP_TC_5",
        "description": "Setup — if Book 1 did not open on its Cover, click Previous until it is on the Cover",
        "testFile": "./test/ExperienceApp/ebookMapping.test.js",
        "testData": [
          {
            "dataFile": "./testResources/testcaseData/ExperienceApp/thor/ebookMappingData.json",
            "jsonPath": "C1.ebookMapping.teardown"
          }
        ],
        "timeout": 180000
      },
      {
        "id": "TST_EMAP_TC_1",
        "description": "Verify Book 1 page ii opens Book 2 page ii and switching back opens the Book 1 Cover",
        "testFile": "./test/ExperienceApp/ebookMapping.test.js",
        "testData": [
          {
            "dataFile": "./testResources/testcaseData/ExperienceApp/thor/ebookMappingData.json",
            "jsonPath": "C1.ebookMapping.scenario1"
          }
        ],
        "timeout": 180000
      }
    ],
    "AfterEach": [],
    "After": [
      {
        "id": "TST_EMAP_TC_5",
        "description": "Teardown — return Book 1 to its Cover with the Previous button (the reader saves Book 1's last visited page)",
        "testFile": "./test/ExperienceApp/ebookMapping.test.js",
        "testData": [
          {
            "dataFile": "./testResources/testcaseData/ExperienceApp/thor/ebookMappingData.json",
            "jsonPath": "C1.ebookMapping.teardown"
