{
  "Suite1": {
    "Name": "Builder Create Umbrella — image save & edit-mode verification (Product Logo)",
    "TestCaseRepo": [
      "./testResources/testcaseRepository/Builder/BuilderTCRepository.json"
    ],
    "Before": [
      {
        "id": "launchUrl",
        "description": "",
