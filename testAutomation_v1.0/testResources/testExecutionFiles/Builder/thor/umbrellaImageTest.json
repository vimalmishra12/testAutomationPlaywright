        "timeout": 120000,
        "testData": [ { "dataFile": "./testResources/testcaseData/Builder/thor/umbrellaImageData.json", "jsonPath": "Builder.umbrellaImage.edit1" } ]
      },
      {
        "id": "TST_BUMB_TC_9",
        "description": "[edit cleanup] Delete the edit-mode fixture umbrella",
        "testFile": "./test/Builder/umbrellaImage.test.js",
        "timeout": 180000,
