{
  "css": {
    "Builder": {
      "preLogin": {
        "orgSelect": "#selectedOrg",
        "loginBtn": "button[type='submit']"
      },
      "loginConfirm": {
        "heading": "h1",
        "loginBtn": "button[type='submit']"
      },
      "idpLogin": {
        "userInput": "#login-user",
        "passInput": "#login-pass",
        "submitBtn": "#login-mfa-btn"
      },
      "landing": {
        "appHeader": "header.sticky"
      },
      "components": {
        "searchInput": "#search",
        "kebabBtn": "button:has([class*='ellipsis-vertical'])",
        "cloneMenuItem": "[role='menuitem']:has-text('Clone')",
        "deleteMenuItem": "[role='menuitem']:has-text('Delete')",
        "itemLink": "a[href='javascript:void(0);']",
        "itemLinkByText": "a[href='javascript:void(0);']:text-is('{text}')",
        "cardByText": "[class*='p-6']:has(a[href='javascript:void(0);']:text-is('{text}'))"
      },
      "cloneModal": {
        "dialog": "[role='dialog']",
        "uniqueCodeInput": "[role='dialog'] input:nth-of-type(1)",
        "titleInput": "[role='dialog'] input:nth-of-type(2)",
        "visibleInputs": "[role='dialog'] input:not([type='hidden'])",
        "textInputs": "[role='dialog'] input.border.rounded",
        "okBtn": "[role='dialog'] button:text-is('OK')",
        "cancelBtn": "[role='dialog'] button:has-text('Cancel')",
        "closeBtn": "[role='dialog'] button:has-text('Close')",
        "errorMsg": "[role='dialog'] pre.vs-text"
      },
      "ebooks": {
        "searchInput": "#search",
        "kebabBtn": "button:has([class*='ellipsis-vertical'])",
        "cloneMenuItem": "[role='menuitem']:has-text('Clone')",
        "deleteMenuItem": "[role='menuitem']:has-text('Delete')",
        "itemLink": "a[href='javascript:void(0);']",
        "itemLinkByText": "a[href='javascript:void(0);']:text-is('{text}')",
        "cardByText": "[class*='p-6']:has(a[href='javascript:void(0);']:text-is('{text}'))",
        "copyHotlinksCheckbox": "[role='dialog'] input[type='checkbox']"
      },
      "ebookCreate": {
        "createNewHeader": "h3:has-text('Create New')",
        "carouselNext": "button:has-text('Next Slide')",
        "studentBookCard": "div.cursor-pointer:has(h3:text-is('Student Book'))",
        "formDialog": "form[name='addEbookForm']",
        "uniqueCodeInput": "#builder-form-field-id",
        "productBuildTitleInput": "#builder-form-field-title",
        "displayTitleInput": "#builder-form-field-display-title",
        "learningMaterialsSummaryInput": "#builder-form-field-short-description",
        "classMaterialsSummaryInput": "#builder-form-field-very-short-description",
        "saveReturnBtn": "button:has-text('Save and Return')"
      },
      "ebookAssets": {
        "detailReady": "h4:has-text('ASSETS & UPLOADS')",
        "processAllBtn": "a:has-text('Process all changes'):visible",
        "processConfirmOk": ".modal:has-text('CONFIRM: Process all changes') button:has-text('Ok')",
        "coverRow": "li:has(span:has-text('PDF, Cover'))",
        "coverImportLink": "li:has(span:has-text('PDF, Cover')) a:has-text('Import')",
        "coverFileInput": "input[type='file'][data-ngf-select=\"ebookVm.onCoverSelect($files)\"]",
        "pagesRow": "li:has(span:has-text('PDF, Pages'))",
        "pagesImportLink": "li:has(span:has-text('PDF, Pages')) a:has-text('Import')",
        "pagesFileInput": "input[type='file'][data-ngf-select=\"ebookVm.onPDFSelect($files)\"]",
        "tocRow": "li:has(span:has-text('XLSX, TOC'))",
        "tocImportLink": "li:has(span:has-text('XLSX, TOC')) a:has-text('Import')",
        "tocFileInput": "input[type='file'][data-ngf-select=\"ebookVm.onTOCSelect($files)\"]",
        "hotlinkRow": "li:has(span:has-text('XLSX, Hotlinks'))",
        "hotlinkImportLink": "li:has(span:has-text('XLSX, Hotlinks')) a:has-text('Import')",
        "hotlinkFileInput": "input[type='file'][data-ngf-select=\"ebookVm.onHotlinkSelect($files)\"]"
      },
      "deleteModal": {
        "dialog": "[role='dialog']",
        "commentInput": "[role='dialog'] textarea",
        "confirmBtn": "[role='dialog'] button:has-text('Confirm')",
        "cancelBtn": "[role='dialog'] button:has-text('Cancel')",
        "closeBtn": "[role='dialog'] button:has-text('Close')"
      },
      "families": {
        "searchInput": "#search",
        "createBtn": "button:has-text('Create a Family')",
        "codeInput": "#uniqueCode",
        "titleInput": "#Title",
        "saveBtn": "button:has-text('Save')",
        "cancelBtn": "button:has-text('Cancel')",
        "deleteBtn": "button:has-text('Delete')",
        "itemLink": "[role='main'] a[href='javascript:void(0)']",
        "itemLinkByText": "[role='main'] a[href='javascript:void(0)']:text-is('{text}')"
      }
    }
  }
}
